POSTGRES_DB=Foodledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST_PORT=5433
FOODLEDGER_API_HTTP_PORT=5062

# 純 HTTP 內網測試使用 InternalTesting；正式部署必須使用 Production 與 HTTPS。
ASPNETCORE_ENVIRONMENT=InternalTesting

# 完整前端 Origin，僅包含協定、主機及連接埠，不包含路徑。
FOODLEDGER_CORS_ALLOWED_ORIGIN=http://localhost:8180

# 單一 API 容器啟動時自動套用尚未執行的 EF Core Migration。
FOODLEDGER_APPLY_MIGRATIONS_ON_STARTUP=true
